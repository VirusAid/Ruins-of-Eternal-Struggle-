msgstr "性格を推測する"

msgid "Assign Ally to Carpentry Work"
msgstr "仲間を大工仕事に割り当てる"

msgid "Assign Ally to Forage for Food"
msgstr "仲間を食料調達に割り当てる"

msgid "Assign Ally to Menial Labor"
msgstr "仲間を単純労働に割り当てる"

msgid "Assign Hospital Raid"
msgstr "スカベンジャー部隊の病院侵入作戦に割り当てる"

msgid "Assign Hotkey [=]"
msgstr "キー割当 [=]"

msgid "Assign Random Mission"
msgstr "ランダムミッション割当"

msgid "Assign Random No-move Mission"
msgstr "ランダム静止ミッション割当"

msgid "Assign Scavenging Patrol"
msgstr "スカベンジャー部隊の巡回に割り当てる"

msgid "Assign Scavenging Raid"
msgstr "スカベンジャー部隊の侵入作戦に割り当てる"

