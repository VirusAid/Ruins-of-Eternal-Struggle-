msgstr "目的地: %s %s"

msgid "Detach"
msgstr "接続解除"

msgid "Detach Leg"
msgstr "肢自切"

msgid "Detach MOLLE attached pouches?"
msgstr "MOLLEアイテムを取り外しますか？"

