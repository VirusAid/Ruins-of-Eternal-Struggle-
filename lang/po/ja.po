msgid "C'mon, <name_g>, I can smell it, pass it over."
msgstr "ちょっと<name_g>、匂うぞ、分けてくれよ。"

msgid "C'mon, you would do the same!  It's life or death out here!"
msgstr "いやいや、同じ状況なら同じことをした筈だ！生きるか死ぬかの世界だろう！"

