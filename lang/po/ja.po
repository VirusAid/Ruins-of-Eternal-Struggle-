msgstr "風力発電出力: "

msgid "Wind/Temp"
msgstr "風/気温"

msgid "Winded"
msgstr "息切れ"

msgid "Winded (Left Arm)"
msgstr "息切れ(左腕)"

msgid "Winded (Left Leg)"
msgstr "息切れ(左脚)"

msgid "Winded (Right Arm)"
msgstr "息切れ(右腕)"

