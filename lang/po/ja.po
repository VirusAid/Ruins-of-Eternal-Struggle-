msgstr "%sは外側から閉められません。"

msgid "You cannot close the %s."
msgstr "%sは閉められません。"

msgid "You cannot connect the %s to itself."
msgstr "%sをそれ自体に接続することはできません。"

msgid "You cannot deconstruct this!"
msgstr "これは分解できません！"

