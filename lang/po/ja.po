msgid "Zambian flag"
msgid_plural "Zambian flags"
msgstr[0] "国旗(ｻﾞﾝﾋﾞｱ)"

msgid "Zap something"
msgstr "電気ショックを与える"

msgid "Zapped"
msgstr "電撃"

msgid "Zelda"
msgstr "ｾﾞﾙﾀﾞ"

msgid "Zen and the Art of Archery"
