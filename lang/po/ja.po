msgid "Really cheap blended whiskey."
msgstr "非常に安価なブレンデッドウイスキーです。"

msgid "Really cheap fortified wine."
msgstr "非常に安価な酒精強化ワインです。"

msgid "Really delete Page?"
msgstr "ページを削除しますか？"

msgid "Really delete note?"
