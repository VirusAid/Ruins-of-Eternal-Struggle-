msgstr "Что делать с коптильней:"

msgid "What to do with your %s?"
msgstr "Что сделать с предметом (%s)?"

msgid ""
"What to do with your %s?\n"
"Hunger: Famished"
msgstr ""
"Что сделать с %s?\n"
"Голод: Изморены"

