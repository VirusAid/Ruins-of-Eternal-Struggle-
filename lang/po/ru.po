msgstr "Отправляйтесь в глубокий лес за семейными семенами."

msgid "Go kill that <name_b>!  NOW!"
msgstr "Иди и убей <name_b>! Сейчас!"

msgid "Go negotiate a trade agreement."
msgstr "Отправляйтесь на переговоры по торговому соглашению."

msgid "Go on, get!"
msgstr "Иди потеряйся!"

msgid "Go on."
msgstr "Продолжай."

