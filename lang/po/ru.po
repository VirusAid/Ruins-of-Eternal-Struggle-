msgstr[0] "флаг Эквадора"
msgstr[1] "флага Эквадора"
msgstr[2] "флагов Эквадора"

msgid "Ed McMahon stands here, lost in thought.  Seeing you, he bellows, \"YES SIR!\""
msgstr "Эд Макмэхон стоит здесь, погрузившись в мысли. Увидев вас, он кричит: «ЕСТЬ, СЭР!»."

msgid "Ed Witten sits here, pondering string theory."
msgstr "Эд Виттен сидит здесь и размышляет о теории струн."

msgid "Eddie Isherwood"
msgstr "Эдди Ишервуд"

msgid "Eddie McKenzie"
msgstr "Эдди МакКензи"

msgid "Eddie's dairy is at the end of the road.  He's may have some jobs for you if you are interested."
msgstr "Молочная ферма Эдди в конце дороги. У него может найтись работа, если интересно."

msgid ""
"Eddie's dairy is at the end of the road.  It's just him and his son since Barry was taken by that thing in the "
"woods."
msgstr ""
"Молочная ферма Эдди в том конце дороги. Он живёт вместе с сыном с тех пор, как та лесная тварь утащила Барри."

msgid "Edge scrolling"
msgstr "Прокрутка по краю"

msgid "Edge scrolling with the mouse."
msgstr "Перемещение на краю карты с помощью мыши."

msgid "Edged Combat"
msgstr "Острый бой"

msgid "Edges.  Lines.  Points.  Happy.  Happy."
msgstr "Края. Линии. Точки. Счастье. Счастье."

msgid "Edible leaves of the grape vine.  Typically used in salads or as a food wrapping."
msgstr "Съедобные листья винограда. Обычно используются в салатах или в качестве пищевой упаковки."

