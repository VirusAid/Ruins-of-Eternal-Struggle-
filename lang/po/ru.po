msgid "Golden monoliths to Sphenocoronae."
msgstr "Золотые монолиты в Клинокорону."

msgid "Golden, jelly-like food with the flavor of apples."
msgstr "Желе золотого цвета с яблочным вкусом."

msgid "Golden-fried potatoes."
msgstr "Картошка, прожаренная до золотой корочки."

msgid "Golf Cart"
msgstr "гольфмобиль"

msgid "Golf Course"
msgstr "Поле для гольфа"

